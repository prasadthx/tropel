package tropel:adapter;

/// Shared types for the Tropel WASM plugin interface.
/// Mirrors the Rust types in `tropel_core::scenario` and `tropel_core::types`.
///
/// NOTE: Recursive types (e.g. scenario-item containing list<scenario-item>)
/// are NOT supported by the Component Model WIT parser. Instead, scenario
/// items use a flat list with a `parent-index` field for tree structure.
interface tropel-types {
    // ── HTTP Method ────────────────────────────────────────────
    enum http-method {
        GET,
        HEAD,
        POST,
        PUT,
        DELETE,
        CONNECT,
        OPTIONS,
        TRACE,
        PATCH,
    }

    // ── Request Body (flat — no recursive types) ───────────────
    variant body {
        /// Raw string payload.
        raw(string),
        /// JSON-encoded payload (stored as text, parsed on demand).
        json(string),
        /// URL-encoded form: key=value&key=value.
        form-urlencoded(list<tuple<string, string>>),
        /// Binary payload (base64-encoded). Decoded by the engine.
        binary(string),
    }

    // ── Cookie ─────────────────────────────────────────────────
    record cookie {
        name: string,
        value: string,
        path: option<string>,
        domain: option<string>,
        secure: bool,
        http-only: bool,
        max-age: option<u64>,
    }

    // ── Auth (flat tuple instead of nested variant) ────────────
    record auth-config {
        /// Auth type: "inherit", "no-auth", "bearer", "basic",
        /// "api-key", "digest", "oauth1", "oauth2", "hawk", "aws-sigv4"
        kind: string,
        /// Credential value(s) — semantics depend on `kind`:
        ///   bearer: token
        ///   basic: "username:password"
        ///   api-key: "key:value"
        ///   others: params string
        credentials: string,
    }

    // ── Request ────────────────────────────────────────────────
    record request {
        url: string,
        method: http-method,
        headers: list<tuple<string, string>>,
        query-params: list<tuple<string, string>>,
        body: option<body>,
        auth: option<auth-config>,
        follow-redirects: bool,
        /// Request timeout in milliseconds. None = use engine default.
        timeout-ms: option<u64>,
    }

    // ── Response (for the imperative driver tier) ──────────────
    record response {
        status-code: u16,
        status-text: string,
        headers: list<tuple<string, string>>,
        /// Raw response body bytes.
        body: list<u8>,
        /// Response time in milliseconds.
        response-time-ms: float64,
        cookies: list<cookie>,
    }

    // ── Scenario Item (flat — parent-index instead of recursive nesting) ──
    record scenario-item {
        id: string,
        name: string,
        request: option<request>,
        /// Pre-request script (JS code).
        prerequest: option<string>,
        /// Test script (JS code, pm.test assertions).
        test: option<string>,
        /// Assertions (Postman-style string expressions).
        assertions: list<string>,
        /// Index into the parent scenario's items list, or -1 for root-level.
        parent-index: s32,
    }

    // ── Scenario ───────────────────────────────────────────────
    record scenario-info {
        name: string,
        description: option<string>,
        /// Postman collection schema version, if applicable.
        schema: option<string>,
    }

    record scenario {
        info: scenario-info,
        items: list<scenario-item>,
        /// Global variables as key-value string pairs.
        variables: list<tuple<string, string>>,
        auth: option<auth-config>,
    }

    // ── Error type ─────────────────────────────────────────────
    record parse-error {
        message: string,
        /// Optional line number for error reporting.
        line: option<u32>,
        /// Optional column number for error reporting.
        column: option<u32>,
    }
}
