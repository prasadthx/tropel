// ── Tropel WASM Adapter World (single canonical file) ──
//
// This is the Component-Model contract for a WASM input-format adapter.
// A WASM component implementing this world can serve as a Tropel input
// adapter: the engine instantiates it, calls `detect` / `parse` from the
// exported `tropel-adapter` interface, and drives the returned scenario.
//
// NOTE: The shipped WASM plugin runtime (`tropel-wasm`) currently uses the
// C-ABI convention (exports `adapter_id`, `adapter_detect`, `adapter_parse`
// over linear memory) rather than this WIT component world. This file is the
// forward-looking Component-Model contract and is kept valid and resolving
// (verified by a `wit-parser` unit test in this crate) so the component path
// can be built when the runtime is ready for it.

package tropel:adapter;

// ── Types interface ─────────────────────────────────────────
interface tropel-types {
    enum http-method {
        GET,
        HEAD,
        POST,
        PUT,
        DELETE,
        CONNECT,
        OPTIONS,
        TRACE,
        PATCH,
    }

    variant body {
        raw(string),
        json(string),
        form-urlencoded(list<tuple<string, string>>),
        binary(list<u8>),
    }

    record cookie {
        name: string,
        value: string,
        path: option<string>,
        domain: option<string>,
        secure: bool,
        http-only: bool,
        max-age: option<u64>,
    }

    record auth-config {
        kind: string,
        credentials: string,
    }

    record request {
        url: string,
        method: http-method,
        headers: list<tuple<string, string>>,
        query-params: list<tuple<string, string>>,
        body: option<body>,
        auth: option<auth-config>,
        follow-redirects: bool,
        timeout-ms: option<u64>,
    }

    record response {
        status-code: u16,
        status-text: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        response-time-ms: f64,
        size: u64,
        cookies: list<cookie>,
    }

    // NOTE: WIT forbids a record containing `list<scenario-item>` of
    // itself, so tree nesting is expressed via the flat `parent-index`
    // field below (the canonical C-ABI JSON shape — the runtime's
    // build_item_tree recovers the tree by grouping on it). The live
    // C-ABI path additionally accepts a recursive nested `items` field;
    // it is not representable in WIT and is omitted here.
    record scenario-item {
        name: string,
        request: option<request>,
        prerequest: option<string>,
        test: option<string>,
        assertions: list<string>,
        parent-index: s32,
    }

    record scenario-info {
        name: string,
        description: option<string>,
        schema: option<string>,
    }

    record scenario {
        info: scenario-info,
        items: list<scenario-item>,
        variables: list<tuple<string, string>>,
        auth: option<auth-config>,
    }

    record parse-error {
        message: string,
        line: option<u32>,
        column: option<u32>,
    }
}

// ── Adapter Interface ────────────────────────────────────────
interface tropel-adapter {
    use tropel-types.{
        scenario,
        parse-error
    };
    id: func() -> string;
    detect: func(bytes: list<u8>) -> bool;
    parse: func(bytes: list<u8>) -> result<scenario, parse-error>;
}

// ── Host Interface (optional logging) ────────────────────────
interface tropel-host {
    log: func(level: string, message: string);
}

// ── World ────────────────────────────────────────────────────
world tropel-adapter-world {
    import tropel-host;
    export tropel-adapter;
}
