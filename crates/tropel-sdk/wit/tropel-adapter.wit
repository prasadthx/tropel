// tropel-adapter.wit — C ABI contract for WASM plugins
//
// This is the canonical specification of the C ABI contract that
// WASM plugins MUST implement. The actual runtime (tropel-wasm)
// uses raw i32 pointer/length calling convention (not WIT Component
// Model), but this file documents the interface types and semantics.
//
// Memory model
// ============
// - The module exports "memory" (linear memory, min 64 pages / 4 MB)
// - If the module exports "malloc" and "free", the host uses those
//   for all buffer allocations (preferred)
// - Without malloc, the host uses fixed offsets:
//   - Page 1 (offset 65536): input buffer
//   - Page 2 (offset 131072): output buffer (min 64 KB)
//
// Error handling
// ==============
// - adapter_parse returns 0 on failure, positive length on success
// - adapter_detect returns 1 (true) or 0 (false)
// - The module should NOT abort/panic across the FFI boundary

/// WASM module describes itself with a short ASCII identifier.
/// The pointer points to a null-terminated UTF-8 string in the
/// module's linear memory.
type string-ptr = u32;

/// A slice of bytes in WASM linear memory.
/// The host writes at the pointer and the module reads from it.
type wasm-buffer = tuple<ptr, len>;

/// Result of the detect function: 1 = can parse, 0 = cannot.
type detect-result = u32;

/// Result of the parse function: positive = output length,
/// 0 = error. On success, output buffer contains JSON-encoded Scenario.
type parse-result = s32;

/// A request to allocate "size" bytes in WASM linear memory.
/// Returns a valid pointer or 0 on OOM.
type alloc-result = u32;
