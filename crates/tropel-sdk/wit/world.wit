package tropel:adapter;

/// Tropel Adapter World — the top-level WASM Component Model contract.
///
/// A WASM component that implements this world can serve as a Tropel input
/// format adapter. The engine instantiates the component, calls `detect` and
/// `parse` from the exported `tropel-adapter` interface, and uses the returned
/// `scenario` to drive the load test.
///
/// ## World structure
///
/// ```
/// ┌──────────────────────────────────────┐
/// │        WASM Component                │
/// │                                      │
/// │  Exports:                            │
/// │    tropel-adapter::id() → string     │
/// │    tropel-adapter::detect(bytes)     │
/// │    tropel-adapter::parse(bytes)      │
/// │                                      │
/// │  Imports (optional):                 │
/// │    tropel-host::log(level, msg)      │
/// └──────────────────────────────────────┘
///         ▲                          │
///         │       scenario           │
///         │                          ▼
///    ┌──────────────────────────────────────┐
///    │         Tropel Engine                │
///    │  (wasmtime Runtime + Registry)       │
///    └──────────────────────────────────────┘
/// ```
///
/// ## Usage from the engine
///
/// ```rust,ignore
/// // Pseudocode for the future WASM runtime:
/// let engine = wasmtime::Engine::default();
/// let component = wasmtime::Component::new(&engine, wasm_bytes)?;
/// let mut linker = wasmtime::Linker::new(&engine);
/// // Bind host functions (logging, etc.)
/// linker.wit_instance("tropel-host", host_instance)?;
/// let instance = linker.instantiate(&mut store, &component)?;
/// let adapter = instance.tropel_adapter(&mut store)?;
///
/// let bytes = std::fs::read("input.har")?;
/// if adapter.call_detect(&mut store, &bytes)? {
///     let scenario = adapter.call_parse(&mut store, &bytes)?;
/// }
/// ```
world tropel-adapter-world {
    /// Import optional host-side functions available to WASM adapters.
    /// Components declare only what they actually use; unused imports
    /// don't need to be provided.
    import tropel-host: tropel:adapter/tropel-host;

    /// Export the adapter interface — the engine calls `detect` and `parse`.
    export tropel-adapter: tropel:adapter/tropel-adapter;
}

/// Optional host functions that a WASM adapter can import.
///
/// The engine provides these if the component requests them. They let
/// adapters log diagnostics during parse (useful for debugging complex
/// format parsers in polyglot WASM).
interface tropel-host {
    /// Log a message at the given severity level.
    /// Levels: "trace", "debug", "info", "warn", "error".
    log: func(level: string, message: string);
}
